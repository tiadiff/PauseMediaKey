<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <AssemblyTitle>PauseMediaKey</AssemblyTitle>
    <Product>PauseMediaKey</Product>
    <Description>Minimalist dark-themed Windows management utility for PauseMediaService.</Description>
    <Company>tiadiff</Company>
    <Copyright>Copyright © 2026 tiadiff</Copyright>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude the sub-project files from default compilation -->
    <Compile Remove="PauseMediaService\**" />
    <Compile Include="PauseMediaService\ServiceConfig.cs" Link="ServiceConfig.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="PauseMediaService\PauseMediaService.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>Content</OutputItemType>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyServiceOutputs" AfterTargets="Build">
    <ItemGroup>
      <ServiceFiles Include="PauseMediaService\bin\$(Configuration)\$(TargetFramework)\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ServiceFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

</Project>
